rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar para verificar se o usuário é o dono do registro
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regras para a coleção de usuários
    match /usuarios/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Regras para transações financeiras
    match /transacoes/{transacaoId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.id_cliente == request.auth.uid || request.resource.data.id_cliente == request.auth.uid);
    }

    // Regras para contas bancárias
    match /contas_bancarias/{contaId} {
      allow read, write: if isAuthenticated() &&
        (contaId == request.auth.uid || resource == null || resource.data.id_cliente == request.auth.uid || request.resource.data.id_cliente == request.auth.uid);
    }

    // Regras para metas financeiras (suporte às coleções 'metas' e 'metas_financeiras')
    match /metas/{metaId} {
      allow read, write: if true;
    }
    match /metas_financeiras/{metaId} {
      allow read, write: if true;
    }

    // Regras para cartões de crédito do usuário
    match /cartoes/{cartaoId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.id_cliente == request.auth.uid || request.resource.data.id_cliente == request.auth.uid);
    }

    // Regras para orçamentos por categoria
    match /orcamentos/{orcamentoId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.id_cliente == request.auth.uid || request.resource.data.id_cliente == request.auth.uid);
    }

    // Regras para notificações
    match /notificacoes/{notificacaoId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.id_cliente == request.auth.uid || resource.data.id_cliente == null || resource.data.id_cliente == 'guest');
    }

    // Regras para configurações do usuário
    match /configuracoes/{configId} {
      allow read, write: if isAuthenticated() &&
        (configId == request.auth.uid || resource == null || resource.data.id_cliente == request.auth.uid || request.resource.data.id_cliente == request.auth.uid);
    }

    // Regras para histórico de chats com o CONRADO
    match /conrado_chats/{chatId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.id_cliente == request.auth.uid || request.resource.data.id_cliente == request.auth.uid);
    }

    // Regra de fallback: bloqueia qualquer outra coleção não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
